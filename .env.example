# --- OpenRouter ---
OPENROUTER_API_KEY=            # your OpenRouter API key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Auth (single-researcher phase: env-based credentials) ---
AUTH_USERNAME=admin
AUTH_PASSWORD=                 # set a strong password
SESSION_SECRET=                # random string, e.g. `openssl rand -hex 32`

# --- Token budget (hard limits, enforced server-side) ---
TOKEN_BUDGET_GLOBAL=5000000    # total tokens across all runs
TOKEN_BUDGET_PER_RUN=500000    # tokens per survey run

# --- Server ---
PORT=3000
DATABASE_PATH=./data/asys.sqlite
